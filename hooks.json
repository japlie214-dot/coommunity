{
  "coom-inbox-reminder": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "~/.coommunity/bin/coom hook --runtime antigravity session-start",
        "timeout": 5
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "~/.coommunity/bin/coom hook --runtime antigravity pre-turn",
        "timeout": 5
      }
    ]
  }
}
