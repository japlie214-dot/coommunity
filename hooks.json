{
  "coom-inbox-reminder": {
    "enabled": true,
    "PreModelRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "coom hook --runtime antigravity pre-turn"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "coom hook --runtime antigravity session-start"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "coom hook --runtime antigravity session-end"
          }
        ]
      }
    ]
  }
}
